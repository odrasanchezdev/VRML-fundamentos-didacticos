#VRML V2.0 utf8
Group{ 
children[ #CHILDREN PRINCIPAL
  Transform{ #TRANSFORM DE TRANSLACION DE LA CAJA
  scale 0.5 0.5 1.0 #ESCALA DE LA CAJA
    children[ #CHILDREN DEL TRANSFORM DE TRANSLACION DE LA CAJA
  Transform{ #TRANSFORM DE ROTACION DE LA CAJA
  rotation 1.0 0.0 0.0 0.5236 #ROTACION DE LA CAJA
    children[#CHILDREN DEL TRANSFORM DE ROTACION
  Transform{ #TRANSFORM DE ESCALA DE LA CAJA
  translation 5.0 4.0 0.0 #TRANSLACION DE LA CAJA
    children[ #CHILDREN DEL TRANSFORM DE ESCALA
       Shape{ #SHAPE DE LA CAJA
           geometry Box{ #GEOMETRY DE LA CAJA
           size 1.0 1.0 1.0 #MEDIDAS DE LA CAJA
                       } #CIERRA GEOMETRY DE LA CAJA
             } #CIERRA SHAPE DE LA CAJA
             ] #CIERRA CHILDREN DEL TRANSFORM DE ESCALA
           } #CIERRA TRANSFORM DE ESCALA
             ] #CIERRA CHILDREN DE TRANSFORM DE ROTACION
             } #CIERRA TRANSFORM DE ROTACION
             ] #CIERRA CHILDREN DE TRANSFORM DE TRANSLACION
            } #CIERRA TRANSFORM DE TRANSLACION
           ] #CIERRA CHILDREN PRINCIPAL
     }  #CIERRA GROUP PRONCIPAL