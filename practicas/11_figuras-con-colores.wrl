#VRML V2.0 utf8
Transform{	#NODO
translation 10.0 0.0 0.0 	#TRASLACION EJE X
	children[	#AGRUPACION
	Shape{		#NODO
	appearance Appearance{	#NODO APPEARANCE
	material Material{	#APARIENCIA
			  diffuseColor 1.0 0.0 0.0
			  emissiveColor 0.0 0.0 0.0
			  specularColor 0.0 0.0 1.0
				ambientIntensity 1.0
				transparency 0.0
				shininess 0.4 }
				} #COLOR Y APARENCIA AL OBJETO
		geometry Sphere{ radius 2.0 }	#NODO ESFERA
	      }
]	#CIERRE AGRUPACION
}	#CIERRE TRANSFORM
Transform{	#NODO
translation 0.0 3.0 0.0		#TRASLACION EJE Y
	children[	#AGRUPACION
	Shape{	#NODO
	appearance Appearance{	#NODO APPEARANCE
	material Material{	#APARIENCIA
			  diffuseColor 0.0 1.0 0.0
			  emissiveColor 1.0 0.0 0.0
			  specularColor 0.0 0.0 0.0
				ambientIntensity 0.0
				transparency 0.0
				shininess 0.0 }
				} #COLOR Y APARENCIA AL OBJETO
		geometry Cone { height 2.0		#NODO CONO
				bottomRadius 2.0}
		}
	 ]#CIERRE AGRUPACION
}#CIERRE TRANSFORM